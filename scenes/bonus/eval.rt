# Scene description file for ray tracer. We made it to assist in the evaluation process :)
# Ambient lighting { intensity color }
A 0.1 255,255,255

# Camera { position direction FOV (aka openness) }
C 4,1.5,-15 0,-0.15,1 20

# Light { position intensity color }
L 4,0,-2 1 255,0,255
L 4,20,0 0.1 255,255,255
#L -10,8,-15 1 255,255,255
#L 0,10,0 0.1 255,255,255

# We should have at least one item (aka cy sp pl)
# basic sphere at the spot 0,0,0#
sp 5,0,0 1 255,255,0 0
sp 4,0,1 1 255,255,0 0.3
sp 3,0,0 1 255,255,0 0.9
#sp 5,0,4 1 255,0,255

# floor plane
pl 0,-0.5,0 0,1,0 200,200,200 0.6

# background plane
#pl -0.5,0,20 1,0,0 0,255,255

# cylinder in frontal camera
#cy 0,-5,0 0,1,0 1 4 255,255,0
#cy 0,-5,-2 -1,0,0 1 2 255,0,255
cy 5,10,-10 1,1,0 4 20 255,255,0
cy 5,0,-20 0,1,0 4 20 255,255,0
sp -5,7,-11 10 255,255,0



# Snowman Eyes
sp -0.75,7,-20 0.7 100,100,100
sp  0.75,7,-20 0.7 100,100,100

# Snowman Nose
sp 0,6.25,-19 0.7 255,102,0

# Snowman Smile
sp -1.7,5.9,-18 0.7 100,100,100
sp -0.85,5.6,-15 0.7 100,100,100
sp  0,5.5,-19 0.7 100,100,100
sp  0.85,5.6,-12 0.7 100,100,100
sp  1.7,5.9,-19 0.7 100,100,100

# Snowman Body
sp 0,6,-18 5 255,255,255
sp 0,1.5,-18 7 255,255,255
sp 0,-5,-18 10 255,255,255

